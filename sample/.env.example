# Kong Admin / Proxy — set to your environment
KONG_ADMIN_TOKEN=
DECK_KONG_ADDR=http://127.0.0.1:8001
KONG_STATUS_URL=https://127.0.0.1:8100/status
KONG_PROXY_URL=http://127.0.0.1:8000

# Reachable from demo containers (Docker DNS or host gateway)
KONG_PROXY_INTERNAL=http://kong-dp:8000
KONG_ADMIN_INTERNAL=http://kong-cp:8001
KONG_PROXY_HEALTH_URL=http://kong-dp:8000/siem-demo/heartbeat

# External Docker network shared with Kong DP / Loki / Fluent Bit
DOCKER_NETWORK=kong-net

DEMO_WORKSPACE=siem-demo
DECK_DEMO_TAG=siem-demo

# Demo UI
SIEM_UI_PORT=3071
LOKI_URL=http://loki:3100
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
DEMO_APIKEY=siem-good-key
